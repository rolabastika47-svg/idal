{% set title_align = design.title.alignment ?? 'left' %}
{% set chart_size = design.container.chart_size.style ?? '350px' %}

%%SELECTOR%% .omsar-circular-chart-title {
  color: {{ design.title.color ?? '#000000' }};
  {{ macros.typography(design.title.typography, globalSettings) }}
  {% if title_align == 'left' %}
  text-align: start;
  {% elseif title_align == 'right' %}
  text-align: end;
  {% else %}
  text-align: center;
  {% endif %}
  {{ macros.spacing_margin_all(design.title.margin) }}
}

%%SELECTOR%% .omsar-circular-chart-container {
  width: {{ chart_size }};
  height: {{ chart_size }};
  margin-left: auto;
  margin-right: auto;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

%%SELECTOR%% .omsar-circular-chart-container canvas {
  display: block;
  max-height: 100%;
}

%%SELECTOR%% .omsar-circular-chart-wrapper {
  text-align: {{ design.advanced.chart_alignment ?? 'center' }};
  {% if design.advanced.chart_width.style is defined %}
  width: {{ design.advanced.chart_width.style }};
  {% else %}
  width: 100%;
  {% endif %}
  background-color: {{ design.container.background_color ?? '#ffffff' }};
  {{ macros.spacing_padding_all(design.container.padding) }}
  {{ macros.borders(design.container.borders) }}
  {% if design.container.border_radius.style is defined %}
  border-radius: {{ design.container.border_radius.style }};
  {% else %}
  border-radius: 8px;
  {% endif %}
  {{ macros.spacing_margin_all(design.advanced.margin) }}
}

html[dir="rtl"] %%SELECTOR%% .omsar-circular-chart-title,
%%SELECTOR%%[dir="rtl"] .omsar-circular-chart-title,
%%SELECTOR%%.omsar-bd-rtl .omsar-circular-chart-title {
  font-family: 'Almarai', sans-serif !important;
}
